# ---------------------------------------------------------------------------
# Analytics dashboard (/dashboard)
#
# Everything here is optional: with none of it set the site builds and runs
# exactly as before, and /dashboard refuses access rather than exposing itself.
# ---------------------------------------------------------------------------

# The ONLY variable sent to the browser, and the only one that collects data.
# Until this is set, nothing is being measured and the dashboard has no history
# to show. GA4 -> Admin -> Data streams.
NEXT_PUBLIC_GA_ID=

# Read access for the dashboard. Server-side only.
# GA4 -> Admin -> Property details (numeric, NOT the G- id).
GA4_PROPERTY_ID=

# Exactly as Search Console lists the property:
#   https://bwmetroproperties.com/      (URL-prefix property)
#   sc-domain:bwmetroproperties.com     (domain property)
GSC_SITE_URL=

# Service account with Viewer on the GA4 property and a user on the Search
# Console property. From its JSON key file.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Keep the quotes and the literal \n escapes.
GOOGLE_PRIVATE_KEY=""

# Password for /dashboard. If this is unset the route is refused outright -
# it never falls open.
DASHBOARD_PASSWORD=
